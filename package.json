{
    "name": "job-scraper-lambda",
    "version": "1.0.0",
    "description": "job scraper — Scrapper Dispatcher + DeepSeek + Neon (TypeScript)",
    "type": "module",
    "main": ".eslintrc.js",
    "scripts": {
        "sam:build": "sam validate --lint && sam build --parallel",
        "sam:deploy": "npm run sam:build && sam deploy --no-confirm-changeset",
        "sam:delete": "aws cloudformation delete-stack --stack-name ",
        "sam:sync": "sam sync --watch --config-env prod --stack-name job-scrapper",
        "typecheck": "tsc --noEmit",
        "db:generate": "npx drizzle-kit generate",
        "db:migrate:script": "npx tsx scripts/migrate.ts",
        "db:migrate": "npx drizzle-kit migrate",
        "lambda": "sam local invoke ScraperDispatcherLambda --env-vars env.json -e event.json --container-host-interface 0.0.0.0"
    },
    "dependencies": {
        "@aws-sdk/client-lambda": "^3.999.0",
        "@aws-sdk/client-s3": "^3.1101.0",
        "@aws-sdk/client-sqs": "^3.999.0",
        "@aws-sdk/client-ssm": "^3.999.0",
        "@neondatabase/serverless": "^0.10.4",
        "@openrouter/ai-sdk-provider": "^3.0.0",
        "@opentelemetry/resources": "^2.10.0",
        "@opentelemetry/sdk-node": "^0.221.0",
        "@posthog/ai": "^8.4.0",
        "ai": "^7.0.37",
        "drizzle-orm": "^0.45.1",
        "esbuild": "^0.27.3",
        "p-limit": "^7.3.1",
        "pg": "^8.19.0",
        "posthog-node": "^5.46.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/aws-lambda": "^8.10.145",
        "@types/node": "^22.0.0",
        "@types/pg": "^8.16.0",
        "drizzle-kit": "^0.31.9",
        "ts-node": "^10.9.2",
        "tsx": "^4.21.0",
        "typescript": "^5.7.0"
    }
}
